# --- App ---
APP_ENV=development
# Port 8000 is already taken by an unrelated Django app on this machine -
# confirmed live, not assumed. Use this port when running uvicorn.
APP_PORT=8010

# --- Vector database (Docker container, pgvector/pgvector:pg16) ---
# POSTGRES_* drive docker-compose; DATABASE_URL is what the app connects
# with. Keep them in sync if you change one.
POSTGRES_USER=secondbrain
POSTGRES_PASSWORD=change-me
POSTGRES_DB=secondbrain
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
DATABASE_URL=postgresql://secondbrain:change-me@localhost:5433/secondbrain
# Separate logical database on the same container - keeps tests from
# competing against real indexed content (see docs/BUILD_LOG.md).
TEST_DATABASE_URL=postgresql://secondbrain:change-me@localhost:5433/secondbrain_test

# --- LLM provider abstraction ---
# Swap providers/models here without touching the RAG code.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:1.5b-instruct
OLLAMA_BASE_URL=http://localhost:11434

# --- Embedding provider abstraction ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
# Empirically measured from the installed model - see docs/BUILD_LOG.md.
# Must match the VECTOR(N) width in database/schema.sql.
EMBEDDING_DIMENSION=768

# --- Knowledge sources ---
OBSIDIAN_VAULT_PATH=
# Comma-separated extra folder/file names to skip, merged with built-in
# defaults (.git, .venv, node_modules, .env, .obsidian, ...) - the defaults
# are never overridden, only added to.
OBSIDIAN_IGNORE_PATTERNS=

# --- RAG / retrieval ---
RAG_ENABLED=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5

# --- Not built yet, off by default ---
WEB_SEARCH_ENABLED=false
CLOUD_LLM_ENABLED=false
